# =============================================================================
# ADERA local sandbox environment
# =============================================================================
# !!! THROWAWAY TEST KEYS — LOCAL POC ONLY !!!
# Every private key below is a well-known, publicly-documented test key. They
# exist ONLY so the sandbox runs deterministically on any machine with zero
# edits. NEVER reuse any of these on a shared, staging, or production network.
# In a real deployment this file holds real secrets and MUST be git-ignored and
# supplied by a secrets manager / HSM.
# =============================================================================

# ---- Infrastructure ----
BESU_IMAGE=hyperledger/besu:24.12.0
CHAIN_ID=20231

# ---- Consortium data-plane key (AES-256-GCM, 32 bytes) ----
# Provisioned out-of-band to every admitted member. Encrypts the routable OCPI
# endpoints stored (as opaque ciphertext) on-chain. Deployer encrypts with it;
# gateways decrypt with it.
ADERA_CONSORTIUM_KEY=0x8d0c9b3a7f1e4d2c5b6a09182736455463728190a1b2c3d4e5f60718293a4b5c

# ---- OCPI registration token (TOKEN_A) ----
REG_TOKEN=ADERA-REG-TOKEN-A

# ---- Governance (legal-entity) keys ----
# 0xfe3b557e8fb62b89f4916b721be55ceb828dbd73  founding CPO operator / deployer / signer 1
DEPLOYER_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63
# 0x627306090abaB3A6e1400e9345bC60c78a8BEf57  founding eMSP operator / signer 2
EMSP_SIGNER_KEY=0xc87509a1c067bbde78beb793e6fa76530b6382a4c0241e5e4a9ec0a0f44dc0d3
# 0xf17f52151EbEF6C7334FAD080c5704D77216b732  PUCSL auditor / observer
AUDITOR_KEY=0xae6ae8e5ccbfb04590405997ee2d52d2b330726137b875053c36d94e974d162f

# ---- Messaging (hot) keys — registry stores their PUBLIC keys ----
# 0x70997970C51812dc3A010C7d01b50e0d17dc79C8  CPO gateway messaging identity
CPO_MESSAGING_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# 0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC  eMSP gateway messaging identity
EMSP_MESSAGING_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# 0x90F79bf6EB2c4f870365E785982E1f101E93b906  EVX (party admitted via multisig demo)
EVX_MESSAGING_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# ---- EVX entity (governance key address; admitted via multisig, does not transact) ----
EVX_ENTITY=0x90F79bf6EB2c4f870365E785982E1f101E93b906
